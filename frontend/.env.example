# Copy to .env.local (gitignored) and fill in. Only public values go here: everything with VITE_ ends up in the browser.
# Supabase: Settings > API Keys. The URL and the publishable (anon) key, never the secret/service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: where the dev server forwards /api (default http://127.0.0.1:8000).
# API_TARGET=
